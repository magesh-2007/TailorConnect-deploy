PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/tailorconnect
JWT_SECRET=replace_with_your_own_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=[your_email@gmail.com](mailto:your_email@gmail.com)
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="TailorConnect" [your_email@gmail.com](mailto:your_email@gmail.com)
SMTP_SECURE=false

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
